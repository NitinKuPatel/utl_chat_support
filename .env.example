APP_ENV=dev
APP_NAME=central-user-service

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=user_management

JWT_SECRET_KEY=change_this_to_a_secure_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DEFAULT_SUPERADMIN_NAME=System Admin
DEFAULT_SUPERADMIN_EMAIL=admin@system.local
DEFAULT_SUPERADMIN_MOBILE=9999999999
DEFAULT_SUPERADMIN_PASSWORD=admin@123

DEFAULT_SUPERADMIN_DEPARTMENT=SYSTEM

# Agent Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini
